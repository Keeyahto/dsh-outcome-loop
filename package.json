{
  "name": "dsh-outcome-loop",
  "version": "0.1.0-beta.7",
  "description": "Local-first task outcome ledger & acceptance plugin for DeepSeek Harness (DSH): evidence-backed verification of task completion, zero extra model cost, user-owned sidecar data. 任务结果账本与验收插件：机械证据验收、默认零额外 token、数据本地持有。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*.js": "./lib/*.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "ARCHITECTURE.md",
    "PRIVACY.md",
    "SECURITY.md",
    "DATA_FORMAT.md",
    "COMPATIBILITY.md",
    "CHANGELOG.md",
    "examples",
    "docs"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "outcome",
    "verification",
    "acceptance",
    "task-ledger",
    "evidence"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/victorzhong0110/dsh-outcome-loop.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-session-persistence": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-message-feedback": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-projection": "0.1.0-rc.7",
    "@deepseek-ai/dsh-storage": "0.1.0-rc.7",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.7",
    "@deepseek-ai/dsh-storage-json": "0.1.0-rc.7",
    "@deepseek-ai/dsh-token-meter": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run test/unit",
    "pack": "pnpm pack",
    "smoke": "node test/smoke/import-smoke.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "zod": "^4.4.3"
  }
}
